# UrbanPick Backend — Environment Configuration
# Copy this file to .env and fill in your values.

# ---------------------------------------------------------------------------
# Environment & Security
# ---------------------------------------------------------------------------
# Application environment mode ("dev", "production", or "staging").
APP_ENV=dev
# Secret API key required for admin/ingest endpoints via X-Api-Key header (refuses requests if empty unless APP_ENV=dev).
INGEST_API_KEY=
# Dedicated API key for automated n8n webhook ingestion pipelines.
N8N_INGEST_API_KEY=
# Comma-separated list of allowed frontend origins for CORS with credentials.
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Set to true in HTTPS production to require the Secure flag on auth session cookies.
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Ollama (local LLM — PRIMARY)
# Run: ollama serve && ollama pull qwen3:8b
# ---------------------------------------------------------------------------
# Base HTTP URL for local Ollama LLM service.
OLLAMA_BASE_URL=http://localhost:11434
# Model name to use in Ollama for assistant comparisons and summarization.
OLLAMA_MODEL=qwen3:8b
# Timeout in seconds for Ollama LLM generation calls.
OLLAMA_TIMEOUT=25

# ---------------------------------------------------------------------------
# Google Gemini (OPTIONAL — fallback if Ollama is unavailable)
# Get a free key at: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
# Optional Google Gemini API key used as fallback when Ollama is unavailable.
GEMINI_API_KEY=
# Gemini model version identifier for reasoning fallback.
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# ChromaDB vector store
# ---------------------------------------------------------------------------
# Filesystem directory path for persistent ChromaDB vector store.
CHROMA_DB_PATH=./chroma_db

# ---------------------------------------------------------------------------
# Multimodal embedding model (SigLIP default, CLIP as fallback)
# ---------------------------------------------------------------------------
# Hugging Face vision-language model for joint image and text embeddings.
EMBEDDING_MODEL_NAME=google/siglip-base-patch16-224
# Maximum number of entries in the in-memory text embedding cache.
EMBEDDING_CACHE_MAXSIZE=512
# Cache expiration time in seconds for text embeddings.
EMBEDDING_CACHE_TTL=3600

# ---------------------------------------------------------------------------
# Limits & Rate Limiting
# ---------------------------------------------------------------------------
# Maximum permitted file size in megabytes for visual product search uploads.
MAX_IMAGE_SIZE_MB=10.0
# Slowapi rate limit rule applied to search, assistant, and budget endpoints.
SEARCH_RATE_LIMIT=30/minute

# ---------------------------------------------------------------------------
# Price Alert Notifications
# Providers: "console" (default, free), "telegram", "sms"
# ---------------------------------------------------------------------------
# Price drop alert notification channel ("console", "telegram", or "sms").
NOTIFY_PROVIDER=console
# Bot authentication token for Telegram alert dispatch.
TELEGRAM_BOT_TOKEN=
# Base URL of the web frontend used in alert notification links.
FRONTEND_BASE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Catalog Data Utilities
# ---------------------------------------------------------------------------
# Optional Pexels API key used by backend/data/fetch_images.py script for image enrichment.
PEXELS_API_KEY=
